# Explicitly declare binary files to prevent corruption during Git operations
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.so binary
*.class binary

# Script line endings
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Auto detect text files and perform LF normalization
* text=auto eol=lf

